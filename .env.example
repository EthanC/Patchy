# Patchy runtime settings. Copy this file to .env, or set these as environment
# variables. What to watch and where to report it lives in config.toml instead.

# Path to config.toml.
PATCHY_CONFIG=config.toml

# Check titles without saving versions or sending notifications.
PATCHY_DRY_RUN=false

# Console log level: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, or CRITICAL.
PATCHY_LOG_LEVEL=INFO

# Optionally forward logs at or above PATCHY_LOG_DISCORD_LEVEL to a Discord webhook.
# PATCHY_LOG_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YYYYYYYY/YYYYYYYY
PATCHY_LOG_DISCORD_LEVEL=WARNING

# SQLite database location.
PATCHY_DATABASE_PATH=patchy.db

# Seconds to wait for upstream services, and retries for transient failures.
PATCHY_HTTP_TIMEOUT=30
PATCHY_HTTP_RETRIES=3
